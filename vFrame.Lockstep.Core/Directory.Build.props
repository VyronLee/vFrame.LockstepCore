<Project>
  <!--
    Redirect the NuGet restore outputs (project.assets.json, *.nuget.g.props/targets,
    project.nuget.cache) for the net8 server project away from the default
    vFrame.Lockstep.Core/obj folder, which the Unity 4.7.1 MSBuild project shares and
    depends on. MSBuildProjectExtensionsPath must be set before Microsoft.Common.props
    is imported (MSB3540 forbids setting it later), so it lives here in Directory.Build.props
    rather than in the net8 csproj body.

    The condition scopes this to the net8 project only: the Unity 4.7.1 project
    (vFrame.Lockstep.Core.csproj) is left completely unaffected by this file.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'vFrame.Lockstep.Core.net8'">
    <MSBuildProjectExtensionsPath>Build\Release\net8\obj\</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
