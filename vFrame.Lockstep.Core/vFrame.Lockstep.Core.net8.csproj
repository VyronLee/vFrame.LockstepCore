<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>vFrame.Lockstep.Core</RootNamespace>
    <AssemblyName>vFrame.Lockstep.Core</AssemblyName>
    <!-- This project lives in the same tree as the Unity 4.7.1 project; the SDK default
         glob (**/*.cs) would pull Properties/AssemblyInfo.cs and the vendored ThirdParty
         sources in unintentionally. Explicit globs keep the server assembly exact.
         Build artifact redirection (obj/, bin/, NuGet restore files) lives in the
         sibling Directory.Build.props so nothing here disturbs `make`. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FarseerPhysics/**/*.cs" />
    <Compile Include="Math/**/*.cs" />
    <Compile Include="PathFinding/**/*.cs" />
    <Compile Include="RVO2/**/*.cs" />
    <Compile Include="TSTime.cs" />
    <Compile Include="ThirdParty/LitJson/**/*.cs" />
  </ItemGroup>
</Project>
